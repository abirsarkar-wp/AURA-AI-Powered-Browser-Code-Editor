# MongoDB connection string used by Prisma
DATABASE_URL="mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/aura?retryWrites=true&w=majority"

# Auth.js signing secret. Generate a long random value for each environment.
AUTH_SECRET="replace-with-a-long-random-secret"

# OAuth app credentials. Configure the callback URLs described in README.md.
AUTH_GITHUB_ID="replace-with-github-oauth-client-id"
AUTH_GITHUB_SECRET="replace-with-github-oauth-client-secret"
AUTH_GOOGLE_ID="replace-with-google-oauth-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-oauth-client-secret"
